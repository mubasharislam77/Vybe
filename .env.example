# ---------------------------------------------------------------------------
# Core (required to boot the app)
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. Create a free/dedicated cluster at
# https://cloud.mongodb.com, add a database user, allow network access from
# your IP (dev) and from 0.0.0.0/0 or Vercel's egress ranges (prod, or use
# Atlas's Vercel integration which configures this for you), then copy the
# "Connect your application" URI here.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vybe

# Session signing secret for Auth.js. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Public base URL of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudinary (product media). Create a free account at https://cloudinary.com
# — these three values are on your Cloudinary dashboard home page.
# Until set, admin media upload is disabled and clearly shown as such.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email order notifications (Resend — https://resend.com). Free tier: no
# card required, 3,000 emails/month. Sign up, copy the API key from
# Dashboard > API Keys. Without verifying your own sending domain (also
# free, just optional), Resend restricts the free tier to sending FROM
# their shared onboarding@resend.dev address TO the email address that
# owns your Resend account — which is exactly what this needs, since the
# recipient is always the store's own admin inbox. Until this is set,
# orders still save normally — notifications just stay "pending" and are
# visible as such in /admin/notifications.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (optional second channel — automatic order
# notifications to an admin phone number). See README "WhatsApp setup" for
# the full walkthrough: Meta Business Manager app, a verified sender
# number, an approved message template, and the webhook subscription.
# NOTE: adding a payment method to a Meta Business account can trigger a
# real (non-trivial) authorization charge attempt — read that section of
# the README before starting this. Until all of these are set, orders
# still save normally — notifications just stay "pending".
# ---------------------------------------------------------------------------
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# E.164 number that receives the automatic new-order alert, e.g. +923001234567
WHATSAPP_ADMIN_NOTIFICATION_NUMBER=
# App secret from Meta, used to verify the X-Hub-Signature-256 header on
# incoming delivery-status webhooks.
WHATSAPP_APP_SECRET=
# Arbitrary string you choose; must match what you enter in the Meta webhook
# subscription "Verify token" field.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Background worker trigger (processes the notification outbox).
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# Optional: Upstash QStash recommended for near-real-time delivery (Vercel
# Hobby cron is daily-only, which is too slow for order alerts). Sign up at
# https://upstash.com — free tier covers typical order volume for a small
# store. If left unset, the outbox is only drained by whatever cron schedule
# you configure in vercel.json (default: every 5 minutes, Pro plan required
# for that frequency — see README).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Admin provisioning (see scripts/provision-admin.ts). Not read at runtime —
# only used once, interactively, to create the first admin account.
# ---------------------------------------------------------------------------
